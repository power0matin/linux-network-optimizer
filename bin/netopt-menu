#!/usr/bin/env bash
# NOTE: We intentionally avoid `set -e` in interactive menus.
# Many network-related commands can return non-zero in valid scenarios (e.g., missing sysctls, qdisc not present).
set -Euo pipefail
# Interactive menu: best-effort operations should not crash the whole UI.
# Critical failures are handled in apply/rollback paths explicitly.

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
NETOPT_BIN="$ROOT_DIR/bin/netopt"
REPO_HINT="$ROOT_DIR"

# Branding
APP_NAME="NetOpt"
APP_TITLE="NetOpt (menu)"

# -------------------------
# UI / UX helpers
# -------------------------
have_cmd() { command -v "$1" >/dev/null 2>&1; }
is_tty()   { [[ -t 1 ]]; }
is_root()  { [[ "${EUID:-$(id -u)}" -eq 0 ]]; }

# Colors only when TTY + tput available
c_reset="" c_bold="" c_dim="" c_red="" c_green="" c_yellow="" c_blue="" c_cyan=""
if is_tty && have_cmd tput; then
  c_reset="$(tput sgr0 || true)"
  c_bold="$(tput bold || true)"
  c_dim="$(tput dim || true)"
  c_red="$(tput setaf 1 || true)"
  c_green="$(tput setaf 2 || true)"
  c_yellow="$(tput setaf 3 || true)"
  c_blue="$(tput setaf 4 || true)"
  c_cyan="$(tput setaf 6 || true)"
fi

# Graceful exit on Ctrl+C / termination (better UX, avoids half-printed screens)
on_abort() {
  printf '\n' >&2
  log_warn "Aborted by user."
  exit 130
}
trap on_abort INT TERM

# No global `trap ERR` for interactive UX stability.
# Errors are handled explicitly in actions and critical operations.

hr() { printf '%s\n' "${c_dim}----------------------------------------${c_reset}"; }
title() { printf '%s%s%s\n' "$c_bold" "$*" "$c_reset"; }

log_info()  { printf '%s[INFO]%s %s\n'  "$c_cyan"  "$c_reset" "$*"; }
log_ok()    { printf '%s[OK]%s   %s\n'  "$c_green" "$c_reset" "$*"; }
log_warn()  { printf '%s[WARN]%s %s\n'  "$c_yellow" "$c_reset" "$*"; }
log_err()   { printf '%s[ERR]%s  %s\n'  "$c_red"   "$c_reset" "$*" >&2; }

pause() {
  # Always read from TTY to avoid piping issues
  if [[ -r /dev/tty ]]; then
    read -r -p "Press Enter to continue... " _ </dev/tty || true
  else
    read -r -p "Press Enter to continue... " _ || true
  fi
}

die() { log_err "$*"; exit 1; }

run_cmd() { "$@"; }

sudo_refresh() {
  # Pre-warm sudo to avoid prompt in the middle of applying network changes
  if is_root; then
    return 0
  fi
  if ! have_cmd sudo; then
    die "sudo is required for this action, but not found."
  fi
  if ! sudo -v; then
    die "sudo authentication failed."
  fi
}

sudo_exec() {
  # No sudo when already root; consistent PATH for privileged execution.
  if is_root; then
    PATH="/usr/sbin:/usr/bin:/sbin:/bin" "$@"
    return $?
  fi

  sudo --preserve-env=TERM,LANG,LC_ALL -- env \
    PATH="/usr/sbin:/usr/bin:/sbin:/bin" \
    "$@"
}


run_root() {
  if is_root; then
    "$@"
  else
    sudo_refresh
    sudo_exec "$@"
  fi
}

run_netopt_root() {
  # Always run netopt with sudo if needed AND handle missing executable bit.
  require_repo
  if is_root; then
    if [[ -x "$NETOPT_BIN" ]]; then
      "$NETOPT_BIN" "$@"
    else
      bash "$NETOPT_BIN" "$@"
    fi
  else
    sudo_refresh
    if [[ -x "$NETOPT_BIN" ]]; then
      sudo_exec "$NETOPT_BIN" "$@"
    else
      sudo_exec bash "$NETOPT_BIN" "$@"
    fi
  fi
}

clear_screen() {
  if is_tty; then clear || true; fi
}

# -------------------------
# Environment / detection
# -------------------------
require_repo() {
  [[ -d "$ROOT_DIR" ]] || die "Repo root not found: $ROOT_DIR"
  [[ -f "$NETOPT_BIN" ]] || die "Missing netopt binary: $NETOPT_BIN"
  [[ -x "$NETOPT_BIN" ]] || log_warn "netopt is not executable yet. I will try to run it via bash if needed."
}

detect_iface() {
  # Best-effort detection. Do NOT exit hard in a menu context.
  # Prints iface on stdout; returns non-zero if not found.
  local iface=""
  if have_cmd ip; then
    iface="$(ip route show default 2>/dev/null | awk '{print $5; exit}')"
    [[ -n "${iface:-}" ]] && { printf '%s\n' "$iface"; return 0; }

    iface="$(ip -o link show up 2>/dev/null | awk -F': ' '$2 != "lo" {print $2; exit}')"
    [[ -n "${iface:-}" ]] && { printf '%s\n' "$iface"; return 0; }
  fi
  return 1
}

get_tcp_cc() {
  if have_cmd sysctl; then
    sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo "unknown"
  else
    echo "unknown"
  fi
}

get_qdisc_line() {
  local iface="$1"
  if have_cmd tc; then
    tc qdisc show dev "$iface" 2>/dev/null | head -n 1 || true
  else
    echo ""
  fi
}

get_kernel() { uname -r 2>/dev/null || echo "unknown"; }

deps_summary() {
  local missing_required=0
  local required=(bash ip sysctl tc awk)
  local optional=(git hostname date)

  for c in "${required[@]}"; do
    if ! have_cmd "$c"; then
      log_err "Missing required dependency: $c"
      missing_required=1
    fi
  done

  for c in "${optional[@]}"; do
    if ! have_cmd "$c"; then
      log_warn "Missing optional dependency: $c (some UI details may be unavailable)"
    fi
  done

  if [[ "$missing_required" -eq 0 ]]; then
    log_ok "Dependencies: OK"
    return 0
  fi

  log_err "One or more required dependencies are missing. Menu may not function correctly."
  return 1
}

# -------------------------
# netopt wrapper
# -------------------------
run_netopt() {
  require_repo
  # Prefer direct execution
  if [[ -x "$NETOPT_BIN" ]]; then
    "$NETOPT_BIN" "$@"
  else
    # Fallback: run with bash (useful if executable bit was missing)
    bash "$NETOPT_BIN" "$@"
  fi
}

# -------------------------
# Input (safe, UX-friendly)
# -------------------------
read_tty() {
  local prompt="$1"
  local out=""
  if [[ -r /dev/tty ]]; then
    read -r -p "$prompt" out </dev/tty || true
  else
    read -r -p "$prompt" out || true
  fi
  printf '%s' "$out"
}

confirm() {
  local msg="${1:-Are you sure?}"
  local ans
  ans="$(read_tty "$msg [y/N]: ")"
  case "${ans,,}" in
    y|yes) return 0 ;;
    *) return 1 ;;
  esac
}

list_ifaces_up() {
  have_cmd ip || return 0
  ip -o link show up 2>/dev/null | awk -F': ' '$2 != "lo" {print $2}'
}

pick_iface() {
  local def="" choice="" iface=""
  def="$(detect_iface 2>/dev/null || true)"

  mapfile -t ifaces < <(list_ifaces_up || true)

  if [[ "${#ifaces[@]}" -gt 0 ]]; then
    printf '%sAvailable interfaces (UP):%s\n' "$c_bold" "$c_reset" >&2
    local i=1
    for it in "${ifaces[@]}"; do
      if [[ -n "$def" && "$it" == "$def" ]]; then
        printf '  %d) %s %s(default)%s\n' "$i" "$it" "$c_dim" "$c_reset" >&2
      else
        printf '  %d) %s\n' "$i" "$it" >&2
      fi
      i=$((i+1))
    done
  fi

  if [[ -n "$def" ]]; then
    choice="$(read_tty "Interface (default: $def or number): ")"
  else
    choice="$(read_tty "Interface (enter name or number): ")"
  fi

  choice="${choice:-$def}"

  if [[ "$choice" =~ ^[0-9]+$ ]] && [[ "${#ifaces[@]}" -gt 0 ]]; then
    local idx=$((choice-1))
    if [[ "$idx" -ge 0 && "$idx" -lt "${#ifaces[@]}" ]]; then
      iface="${ifaces[$idx]}"
    else
      log_warn "Invalid interface number."
      iface="${def:-}"
    fi
  else
    iface="$choice"
  fi

  [[ -n "$iface" ]] || die "Could not determine network interface. Please enter it manually."
  printf '%s\n' "$iface"
}

pick_profile() {
  local choice
  while true; do
    printf '%sSelect profile:%s\n' "$c_bold" "$c_reset" >&2
    printf '  1) safe       (recommended for first run)\n' >&2
    printf '  2) balanced   (good general default)\n' >&2
    printf '  3) aggressive (only if you know your workload)\n' >&2
    choice="$(read_tty "Choice [1-3] (default 2): ")"
    choice="${choice:-2}"
    case "$choice" in
      1) echo "safe"; return 0 ;;
      2) echo "balanced"; return 0 ;;
      3) echo "aggressive"; return 0 ;;
      *) log_warn "Invalid choice. Please select 1-3." >&2 ;;
    esac
  done
}

pick_qdisc() {
  local choice
  while true; do
    printf '%sSelect qdisc:%s\n' "$c_bold" "$c_reset" >&2
    printf '  1) fq_codel (great general default)\n' >&2
    printf '  2) cake     (best fairness/latency if available)\n' >&2
    printf '  3) fq       (minimal)\n' >&2
    choice="$(read_tty "Choice [1-3] (default 1): ")"
    choice="${choice:-1}"
    case "$choice" in
      1) echo "fq_codel"; return 0 ;;
      2) echo "cake"; return 0 ;;
      3) echo "fq"; return 0 ;;
      *) log_warn "Invalid choice. Please select 1-3." >&2 ;;
    esac
  done
}

# -------------------------
# Rendering
# -------------------------
get_host() { hostname 2>/dev/null || echo "unknown"; }
get_user() { id -un 2>/dev/null || echo "unknown"; }
get_time() { date -Is 2>/dev/null || date; }

get_git_rev() {
  if have_cmd git && [[ -d "$ROOT_DIR/.git" ]]; then
    git -C "$ROOT_DIR" rev-parse --short HEAD 2>/dev/null || true
  fi
}

header() {
  clear_screen
  printf '%s\n' "${c_blue}${c_bold}"
  cat <<'EOF'
  _   _      _    ___        _   
 | \ | | ___| |_ / _ \ _ __ | |_ 
 |  \| |/ _ \ __| | | | '_ \| __|
 | |\  |  __/ |_| |_| | |_) | |_ 
 |_| \_|\___|\__|\___/| .__/ \__|
                      |_|        
EOF
  printf '%s\n' "${c_reset}"

  local rev=""
  rev="$(get_git_rev)"
  printf '%s%s%s\n' "$c_bold" "$APP_TITLE" "$c_reset"
  printf '%sRepo:%s %s\n' "$c_dim" "$c_reset" "$REPO_HINT"
  printf '%sHost:%s %s  %sUser:%s %s  %sTime:%s %s\n' \
    "$c_dim" "$c_reset" "$(get_host)" \
    "$c_dim" "$c_reset" "$(get_user)" \
    "$c_dim" "$c_reset" "$(get_time)"
  if [[ -n "${rev:-}" ]]; then
    printf '%sCommit:%s %s\n' "$c_dim" "$c_reset" "$rev"
  fi

  hr
  deps_summary
  hr
}

get_iface_state() {
  local iface="$1"
  cat "/sys/class/net/$iface/operstate" 2>/dev/null || echo "unknown"
}

get_iface_mtu() {
  local iface="$1"
  cat "/sys/class/net/$iface/mtu" 2>/dev/null || echo "unknown"
}

get_iface_speed_mbps() {
  # Works on many NICs; on virtual NICs it may be missing
  local iface="$1"
  local sp
  sp="$(cat "/sys/class/net/$iface/speed" 2>/dev/null || true)"
  [[ -n "${sp:-}" && "$sp" != "-1" ]] && echo "${sp}Mb/s" || echo "unknown"
}

get_iface_ip4() {
  local iface="$1"
  [[ -n "${iface:-}" ]] || return 0
  if have_cmd ip; then
    ip -4 -o addr show dev "$iface" 2>/dev/null | awk '{print $4}' | head -n 1 || true
  fi
}

MENU_VERBOSE=0

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --verbose) MENU_VERBOSE=1; shift ;;
      --help|-h)
        cat <<EOF
${APP_TITLE}
Usage:
  bin/menu.sh [--verbose]

Env:
  NETOPT_MENU_VERBOSE=1   Show full IP addresses and extra details.
EOF
        exit 0
        ;;
      *) shift ;;
    esac
  done

  if [[ "${NETOPT_MENU_VERBOSE:-0}" == "1" ]]; then
    MENU_VERBOSE=1
  fi
}

mask_ipv4_cidr() {
  local cidr="${1:-}"
  [[ -n "$cidr" ]] || { echo ""; return 0; }

  local ip="${cidr%/*}"
  local mask="${cidr#*/}"
  if [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ && "$mask" =~ ^[0-9]{1,2}$ ]]; then
    echo "$(echo "$ip" | awk -F. '{printf "%s.%s.%s.x", $1,$2,$3}')/$mask"
  else
    echo "$cidr"
  fi
}

show_quick_status() {
  local iface="" cc qdisc kernel ip4 state mtu speed
  iface="$(detect_iface 2>/dev/null || true)"
  kernel="$(get_kernel)"
  cc="$(get_tcp_cc)"

  title "Quick status"
  printf '  kernel : %s\n' "$kernel"

  if [[ -z "${iface:-}" ]]; then
    printf '  iface  : (unknown)\n'
    printf '  tcp_cc : %s\n' "$cc"
    printf '  qdisc  : (no data)\n'
    hr
    return 0
  fi

  qdisc="$(get_qdisc_line "$iface")"
  ip4="$(get_iface_ip4 "$iface")"
  state="$(get_iface_state "$iface")"
  mtu="$(get_iface_mtu "$iface")"
  speed="$(get_iface_speed_mbps "$iface")"

  printf '  iface  : %s\n' "$iface"
  printf '  state  : %s\n' "$state"
  printf '  mtu    : %s\n' "$mtu"
  printf '  speed  : %s\n' "$speed"

  if [[ -n "${ip4:-}" ]]; then
    if [[ "$MENU_VERBOSE" -eq 1 ]]; then
      printf '  ip4    : %s\n' "$ip4"
    else
      printf '  ip4    : %s\n' "$(mask_ipv4_cidr "$ip4")"
    fi
  else
    printf '  ip4    : (none)\n'
  fi

  printf '  tcp_cc : %s\n' "$cc"
  if [[ -n "${qdisc:-}" ]]; then
    printf '  qdisc  : %s\n' "$qdisc"
  else
    printf '  qdisc  : (no data)\n'
  fi
  hr
}

menu_print() {
  title "Choose an action"
  cat <<EOF
  1) Run checks (diagnose)
  2) Apply tuning (profile + qdisc)   ${c_dim}[requires sudo]${c_reset}
  3) Show current qdisc
  4) List backups
  5) Rollback (latest backup)        ${c_dim}[requires sudo]${c_reset}
  6) Show snapshot (sysctl/qdisc via CLI)
  0) Exit
EOF
  printf '\n'
}

# -------------------------
# Actions
# -------------------------
action_checks() {
  log_info "Running checks..."
  run_netopt check
  log_ok "Checks completed."
}

action_apply() {
  local iface profile qdisc
  iface="$(pick_iface)"
  profile="$(pick_profile)"
  qdisc="$(pick_qdisc)"

  hr
  log_info "Planned apply:"
  printf '  iface   : %s\n' "$iface"
  printf '  profile : %s\n' "$profile"
  printf '  qdisc   : %s\n' "$qdisc"
  hr

  if ! confirm "Proceed to APPLY these changes?"; then
    log_warn "Apply cancelled."
    return 0
  fi

    log_info "Applying tuning (requires sudo)..."
    # Pre-warm sudo before applying network changes (better UX)
    if ! is_root; then sudo_refresh; fi

  if run_netopt_root apply --profile "$profile" --qdisc "$qdisc" --iface "$iface"; then
    log_ok "Apply completed."
  else
    log_err "Apply failed."
    log_err "Recommendation: run 'bin/netopt rollback --latest' to revert, or check logs/backups."
    return 1
  fi

  # Lightweight verification (network engineer-friendly, not noisy)
  hr
  log_info "Verify (post-apply):"
  if have_cmd sysctl; then
    printf '  tcp_cc : %s\n' "$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo "unknown")"
  fi
  if have_cmd tc; then
    printf '  qdisc  : %s\n' "$(tc qdisc show dev "$iface" 2>/dev/null | head -n 1 || echo "(no data)")"
  fi
  hr
}

action_show_qdisc() {
  local iface
  iface="$(pick_iface)"
  hr
  if have_cmd tc; then
    tc qdisc show dev "$iface" || true
  else
    log_warn "tc not found."
  fi
  hr
}

action_backups() {
  hr
  run_netopt backups
  hr
}

action_rollback_latest() {
  local iface
  iface="$(detect_iface)"

  hr
  log_warn "Rollback will revert sysctl/qdisc changes from the latest backup."
  if ! confirm "Proceed to ROLLBACK latest backup?"; then
    log_warn "Rollback cancelled."
    return 0
  fi

log_info "Rolling back (requires sudo)..."
# Pre-warm sudo before rollback (better UX)
if ! is_root; then sudo_refresh; fi

if run_netopt_root rollback --latest; then
    log_ok "Rollback completed."
  else
    log_err "Rollback failed."
    return 1
  fi

  hr
  log_info "Verify (post-rollback):"
  if have_cmd sysctl; then
    printf '  tcp_cc : %s\n' "$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo "unknown")"
  fi
  if have_cmd tc; then
    printf '  qdisc  : %s\n' "$(tc qdisc show dev "$iface" 2>/dev/null | head -n 1 || echo "(no data)")"
  fi
  hr
}

action_snapshot() {
  local iface
  iface="$(detect_iface)"

  hr
  log_info "Snapshot:"
  printf '  kernel : %s\n' "$(get_kernel)"
  printf '  iface  : %s\n' "$iface"

  if have_cmd tc; then
    printf '  qdisc  : %s\n' "$(tc qdisc show dev "$iface" 2>/dev/null | head -n 1 || echo "(no data)")"
  fi

  if have_cmd sysctl; then
    # minimal, high-signal sysctls for server workloads
    printf '  tcp_cc : %s\n' "$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo "unknown")"
    printf '  somaxconn : %s\n' "$(sysctl -n net.core.somaxconn 2>/dev/null || echo "n/a")"
    printf '  rmem_max  : %s\n' "$(sysctl -n net.core.rmem_max 2>/dev/null || echo "n/a")"
    printf '  wmem_max  : %s\n' "$(sysctl -n net.core.wmem_max 2>/dev/null || echo "n/a")"
  fi
  hr
}

# -------------------------
# Main loop
# -------------------------
menu_loop() {
  while true; do
    header
    show_quick_status
    menu_print

    local choice
    choice="$(read_tty "Enter choice [0-6]: ")"
    case "${choice:-}" in
      1) action_checks; pause ;;
      2) action_apply; pause ;;
      3) action_show_qdisc; pause ;;
      4) action_backups; pause ;;
      5) action_rollback_latest; pause ;;
      6) action_snapshot; pause ;;
      0) exit 0 ;;
      *) log_err "Invalid choice."; pause ;;
    esac
  done
}

main() {
  # Do not force sudo on startup: only apply/rollback need it.
  parse_args "$@"

  require_repo

  # If required deps are missing, fail early (predictable behavior).
  if ! deps_summary >/dev/null 2>&1; then
    deps_summary || true
    exit 1
  fi

  menu_loop
}

main "$@"
